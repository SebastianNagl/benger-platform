    "/api/v1/projects/{project_id}/exports": {
      "post": {
        "tags": [
          "exports"
        ],
        "summary": "Start a project export",
        "description": "Queue an export of the whole project (or of ``task_ids``, json only).\nPoll ``GET /api/v1/exports/{id}`` until ``status`` is ``completed``.",
        "operationId": "create_export_api_v1_projects__project_id__exports_post",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional client-chosen key (1 to 255 characters). Retries with the same key and request replay the first response for 24 hours.",
              "title": "Idempotency-Key"
            },
            "description": "Optional client-chosen key (1 to 255 characters). Retries with the same key and request replay the first response for 24 hours."
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ExportCreate"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportJobOut"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired or revoked key",
            "content": {
