{
  "openapi": "3.1.0",
  "info": {
    "title": "BenGER Public API",
    "description": "Versioned, key-authenticated access to BenGER projects and tasks.\n\nAuthenticate with an access key: `Authorization: Bearer bgr_<env>_<id>_<secret>`.\nEvery operation lists the scopes it needs under `x-benger-scopes`. Errors use\nthe envelope `{\"error\": {\"code\", \"message\", \"request_id\", \"details\"}}`.\nLists are cursor-paginated (`limit`, `cursor`, `next_cursor`). See\ndocs/public-api.md in the platform repository for the full guide.\n",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.what-a-benger.net"
    }
  ],
  "paths": {
    "/api/v1/me": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "The calling key or session",
        "description": "Describe the credential: its kind, expanded scopes, project allowlist,\norganization and group, expiry and rate limit, plus the user it acts as\n(the service account for an organization key). Needs no scope.",
        "operationId": "get_me_api_v1_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired or revoked key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-benger-scopes": []
      }
    },
