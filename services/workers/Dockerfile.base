# Workers Base Image: Python + PyTorch + ML models + NLTK data
# Rebuild when: uv.lock or this file changes (see build-workers-base.yml)
# App code is NOT included — see Dockerfile which builds on top of this.
#
# Python 3.13, unblocked by moving to numpy 2.x + spaCy 3.8 / thinc 8.3.x
# (see pyproject.toml). The spacy.load() + NER assertion at the end of this
# file is the ABI guard — it fails the build if that stack ever regresses.
FROM python:3.13-slim

# System dependencies (procps for health checks, gcc/g++ for C extensions)
RUN apt-get update && apt-get install -y --no-install-recommends \
    procps \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install uv for dependency management. Pinned: it reads uv.lock, so the
# version that wrote the lock (or newer) must be the one that installs it.
RUN pip install uv==0.11.28

WORKDIR /app

# Install exactly the locked set from uv.lock into the system interpreter.
# torch is locked to the CPU-only build (the [tool.uv.index] / [tool.uv.sources]
# block in pyproject.toml decides that at `uv lock` time, and the lock records
# the download.pytorch.org wheels); nothing index-related belongs in this file.
# --locked fails the build when uv.lock no longer matches pyproject.toml
# instead of re-resolving; --inexact keeps pip and uv, which the lock omits.
COPY pyproject.toml uv.lock ./
RUN UV_PROJECT_ENVIRONMENT=/usr/local uv sync --locked --no-dev --no-install-project --inexact --no-cache

# Set PYTHONPATH so local modules can be imported
ENV PYTHONPATH=/app

# Pre-download ALL ML models and NLTK data.
# This layer is cached and only invalidated when the dependency layer changes.
RUN python -c "\
import nltk; \
nltk.download('punkt'); \
nltk.download('punkt_tab'); \
nltk.download('averaged_perceptron_tagger'); \
nltk.download('averaged_perceptron_tagger_eng'); \
nltk.download('maxent_ne_chunker'); \
nltk.download('words'); \
nltk.download('wordnet'); \
nltk.download('omw-1.4'); \
\
from transformers import AutoTokenizer, AutoModelForQuestionAnswering, AutoModel, AutoModelForSequenceClassification, T5Tokenizer, T5ForConditionalGeneration; \
\
print('Downloading QAGS models...'); \
AutoTokenizer.from_pretrained('distilbert-base-cased-distilled-squad'); \
AutoModelForQuestionAnswering.from_pretrained('distilbert-base-cased-distilled-squad'); \
T5Tokenizer.from_pretrained('t5-small'); \
T5ForConditionalGeneration.from_pretrained('t5-small'); \
\
print('Downloading BERTScore model (roberta-large)...'); \
AutoTokenizer.from_pretrained('roberta-large'); \
AutoModel.from_pretrained('roberta-large'); \
\
print('Downloading sentence-transformers model...'); \
from sentence_transformers import SentenceTransformer; \
SentenceTransformer('paraphrase-multilingual-MiniLM-L12-v2'); \
\
print('Downloading FactCC/SummaC models...'); \
AutoTokenizer.from_pretrained('tals/albert-xlarge-vitaminc-mnli'); \
AutoModelForSequenceClassification.from_pretrained('tals/albert-xlarge-vitaminc-mnli'); \
AutoTokenizer.from_pretrained('manueldeprada/FactCC'); \
AutoModelForSequenceClassification.from_pretrained('manueldeprada/FactCC'); \
\
print('Validating spaCy German NER pipeline (de_core_news_md installed via pip)...'); \
import spacy; \
nlp = spacy.load('de_core_news_md'); \
test = nlp('Klaegerin K verlangt von Beklagtem V Uebergabe nach Paragraph 433 BGB. Der Vertrag wurde in Muenchen geschlossen.'); \
ents = [(e.text, e.label_) for e in test.ents]; \
assert any(label in ('PER', 'LOC', 'ORG', 'MISC') for _, label in ents), \
    f'spaCy de_core_news_md NER produced no entities on canonical legal-DE input: {ents}'; \
print('spaCy de_core_news_md NER OK:', ents); \
\
print('All models downloaded successfully.')"
