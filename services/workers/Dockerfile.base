# Workers Base Image: Python + PyTorch + ML models + NLTK data
# Rebuild when: uv.lock or this file changes (see build-workers-base.yml)
# App code is NOT included — see Dockerfile which builds on top of this.
#
# Python 3.13, unblocked by moving to numpy 2.x + spaCy 3.8 / thinc 8.3.x
# (see pyproject.toml). The spacy.load() + NER assertion at the end of this
# file is the ABI guard — it fails the build if that stack ever regresses.
#
# The image ends as the unprivileged uid 1000 with HF_HOME=/opt/hf and
# HF_HUB_OFFLINE=1. Images built FROM it switch to root for their own install
# steps and back to 1000 at the end (see Dockerfile).
FROM python:3.13-slim

# System dependencies (procps for health checks, gcc/g++ for C extensions)
RUN apt-get update && apt-get install -y --no-install-recommends \
    procps \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install uv for dependency management. Pinned: it reads uv.lock, so the
# version that wrote the lock (or newer) must be the one that installs it.
RUN pip install uv==0.11.28

WORKDIR /app

# Install exactly the locked set from uv.lock into the system interpreter.
# torch is locked to the CPU-only build (the [tool.uv.index] / [tool.uv.sources]
# block in pyproject.toml decides that at `uv lock` time, and the lock records
# the download.pytorch.org wheels); nothing index-related belongs in this file.
# --locked fails the build when uv.lock no longer matches pyproject.toml
# instead of re-resolving; --inexact keeps pip and uv, which the lock omits.
COPY pyproject.toml uv.lock ./
RUN UV_PROJECT_ENVIRONMENT=/usr/local uv sync --locked --no-dev --no-install-project --inexact --no-cache

# Set PYTHONPATH so local modules can be imported
ENV PYTHONPATH=/app

# Unprivileged runtime user. uid/gid 1000 matches the pod securityContext in
# infra/helm/benger, so files baked here are owned by the uid the pods run as.
RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid 1000 --create-home --home-dir /home/app --shell /usr/sbin/nologin app

# Model caches live outside any home directory so they do not depend on which
# uid runs the container. HF_HOME matches the Helm worker pool env. NLTK data
# goes to /usr/local/share/nltk_data, which is on nltk's default search path
# (sys.prefix/share/nltk_data), so no NLTK_DATA variable is needed. It stays
# root-owned and not group/world-writable: nltk 3.10 refuses a data root owned
# by any account other than the current one or root, so root ownership is the
# one layout that both uid 1000 (pods) and root (test runner) accept.
ENV HF_HOME=/opt/hf

# Pre-download ALL ML models and NLTK data.
# This layer is cached and only invalidated when the dependency layer changes.
#
# BERTScore: the code always scores with lang="de" (ml_evaluation/metrics/
# semantic.py, ml_evaluation/sample_evaluator.py), and bert_score maps "de" to
# bert-base-multilingual-cased (bert_score.utils.lang2model), which the ONNX
# backend uses as well. roberta-large is only the lang="en" model and is not
# baked any more. Warming the cache with a real score() call fetches exactly
# the files bert_score loads, so the offline runtime below finds all of them.
#
# The chown runs in the same layer as the downloads; a separate RUN would copy
# the multi-GB cache into a second layer.
RUN python -c "\
import nltk; \
d = '/usr/local/share/nltk_data'; \
nltk.download('punkt', download_dir=d); \
nltk.download('punkt_tab', download_dir=d); \
nltk.download('averaged_perceptron_tagger', download_dir=d); \
nltk.download('averaged_perceptron_tagger_eng', download_dir=d); \
nltk.download('maxent_ne_chunker', download_dir=d); \
nltk.download('words', download_dir=d); \
nltk.download('wordnet', download_dir=d); \
nltk.download('omw-1.4', download_dir=d); \
\
from transformers import AutoTokenizer, AutoModelForQuestionAnswering, AutoModel, AutoModelForSequenceClassification, T5Tokenizer, T5ForConditionalGeneration; \
\
print('Downloading QAGS models...'); \
AutoTokenizer.from_pretrained('distilbert-base-cased-distilled-squad'); \
AutoModelForQuestionAnswering.from_pretrained('distilbert-base-cased-distilled-squad'); \
T5Tokenizer.from_pretrained('t5-small'); \
T5ForConditionalGeneration.from_pretrained('t5-small'); \
\
print('Downloading BERTScore model for lang=de...'); \
from bert_score import score as bert_score; \
from bert_score.utils import lang2model; \
print('bert_score lang2model[de] =', lang2model['de']); \
bert_score(['Der Vertrag ist wirksam.'], ['Der Vertrag ist gueltig.'], lang='de', rescale_with_baseline=True, verbose=False); \
\
print('Downloading sentence-transformers model...'); \
from sentence_transformers import SentenceTransformer; \
SentenceTransformer('paraphrase-multilingual-MiniLM-L12-v2'); \
\
print('Downloading FactCC/SummaC models...'); \
AutoTokenizer.from_pretrained('tals/albert-xlarge-vitaminc-mnli'); \
AutoModelForSequenceClassification.from_pretrained('tals/albert-xlarge-vitaminc-mnli'); \
AutoTokenizer.from_pretrained('manueldeprada/FactCC'); \
AutoModelForSequenceClassification.from_pretrained('manueldeprada/FactCC'); \
\
print('Validating spaCy German NER pipeline (de_core_news_md installed via pip)...'); \
import spacy; \
nlp = spacy.load('de_core_news_md'); \
test = nlp('Klaegerin K verlangt von Beklagtem V Uebergabe nach Paragraph 433 BGB. Der Vertrag wurde in Muenchen geschlossen.'); \
ents = [(e.text, e.label_) for e in test.ents]; \
assert any(label in ('PER', 'LOC', 'ORG', 'MISC') for _, label in ents), \
    f'spaCy de_core_news_md NER produced no entities on canonical legal-DE input: {ents}'; \
print('spaCy de_core_news_md NER OK:', ents); \
\
print('All models downloaded successfully.')" \
    && chown -R 1000:1000 /opt/hf

# Pods never reach out to the Hugging Face Hub at runtime: every model the code
# loads is baked above, and a missing one fails loudly instead of downloading
# gigabytes on the first evaluation.
ENV HF_HUB_OFFLINE=1

USER 1000
