# Frontend Development Dockerfile
# Optimized for hot reloading and development workflow

FROM node:24-alpine

# Set working directory
WORKDIR /app

# Install dependencies for native modules and curl for health checks
RUN apk add --no-cache libc6-compat curl

# Copy package files and install exactly what the lockfile pins. The stamp
# records which lockfile this node_modules belongs to, so the entrypoint can
# tell when a carried-over node_modules volume no longer matches it.
COPY package.json package-lock.json .npmrc ./
RUN npm ci --no-audit --no-fund && \
    sha256sum package-lock.json | cut -d' ' -f1 > node_modules/.lockfile-sha256

# Copy entrypoint script
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Set development environment
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

# Use entrypoint for better startup coordination
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Start development server with hot reloading
CMD ["npm", "run", "dev"]